# Keep the build context small and free of secrets (spec §3.1).
.git
.github
.idea
.vscode
.env
.env.*
!.env.example
auth.json

node_modules
vendor
resources/angular/node_modules
resources/angular/dist
resources/angular/.angular

# Built SPA files published into public/ by `npm run build` locally; the image builds its own.
public/index.html
public/*.js
public/*.css
public/favicon.svg
public/media
public/3rdpartylicenses.txt
public/prerendered-routes.json
public/.spa-manifest.json
public/hot
public/storage

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*
bootstrap/cache/*.php
database/*.sqlite

tests
k8s
docs
specifications
Dockerfile
.dockerignore
*.log
.phpunit.cache
.phpunit.result.cache
phpstan.neon
